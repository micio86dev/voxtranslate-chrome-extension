# Copy to `.env` for local development. No secrets belong in this file — the extension
# holds no API keys; all privileged calls go through the VoxTranslate backend.

# Backend API + WebSocket origin. The WS origin is derived by swapping http→ws.
VITE_API_ORIGIN=https://api.voxtranslate.app

# The consumer web app: login handoff page and the buy-credit page.
VITE_APP_ORIGIN=https://app.voxtranslate.app

# Local development example:
# VITE_API_ORIGIN=http://localhost:8080
# VITE_APP_ORIGIN=http://localhost:4321
